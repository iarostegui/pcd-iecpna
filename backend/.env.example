# PCD — configuración local (copiar a .env; nunca versionar .env)
PCD_ENV=local
PCD_API_BASE_PATH=/api/v1
PCD_DB_HOST=127.0.0.1
PCD_DB_PORT=3306
PCD_DB_NAME=pcd
PCD_DB_USER=pcd_app
PCD_DB_PASSWORD=
PCD_ALLOWED_ORIGINS=http://localhost:5173
PCD_SESSION_NAME=__Host-pcd_sid
PCD_CSRF_ENABLED=true
# Credenciales SOLO para UAT/pruebas sintéticas. En producción se usan
# credenciales individuales provistas fuera del repositorio.
PCD_UAT_DIGITADOR_PASSWORD=
PCD_ADMIN_PASSWORD=
PCD_REPORTES_PASSWORD=
