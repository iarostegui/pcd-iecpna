# PCD — configuración local (copiar a .env; nunca versionar .env)
PCD_ENV=local
PCD_API_BASE_PATH=/api/v1
PCD_DB_HOST=127.0.0.1
PCD_DB_PORT=3306
PCD_DB_NAME=pcd
PCD_DB_USER=pcd_app
PCD_DB_PASSWORD=
PCD_ALLOWED_ORIGINS=http://localhost:5173
# Producción: __Host-pcd_sid + PCD_COOKIE_SECURE=true sobre HTTPS.
# Desarrollo HTTP local: nombre sin prefijo __Host y Secure desactivado.
PCD_SESSION_NAME=pcd_dev_sid
PCD_COOKIE_SECURE=false
PCD_CSRF_ENABLED=true
# Sesión: 45 min de inactividad, 12 h absolutas; last_seen se toca cada 60 s.
PCD_SESSION_IDLE_MINUTES=45
PCD_SESSION_ABSOLUTE_HOURS=12
PCD_SESSION_TOUCH_SECONDS=60
# Límites de intentos de login.
PCD_LOGIN_MAX_ACCOUNT=5
PCD_LOGIN_MAX_IP=20
PCD_LOGIN_WINDOW_MINUTES=15
# Fallback SOLO desarrollo/CI sin Argon2id. Nunca en producción.
PCD_ALLOW_BCRYPT_FALLBACK=false
# Credenciales SOLO para UAT/pruebas sintéticas. En producción se usan
# credenciales individuales provistas fuera del repositorio.
PCD_UAT_DIGITADOR_PASSWORD=
PCD_ADMIN_PASSWORD=
PCD_REPORTES_PASSWORD=
